---
import '../styles/global.css';
import { contentPath, equivalentPath, localePaths, publicPath } from '../lib/locale';

interface Props {
  title: string;
  description: string;
  current?: 'blog';
  locale?: 'vi' | 'en';
}

const pathname = contentPath(Astro.url.pathname);
const {
  title,
  description,
  current,
  locale = pathname.startsWith('/vi/') ? 'vi' : 'en',
} = Astro.props;
const en = locale === 'en';
const home = localePaths[locale].home;
const homeLink = Astro.url.pathname === home ? '#main' : home;
const blog = localePaths[locale].blog;
const equivalents = {
  en: equivalentPath(pathname, 'en'),
  vi: equivalentPath(pathname, 'vi'),
};
const canonical = new URL(publicPath(pathname), Astro.site).href;
const sitemap = new URL(publicPath('/sitemap.xml'), Astro.site).href;
const nav = [
  { href: `${home}#platform`, label: en ? 'Platform' : 'Nền tảng' },
  { href: `${home}#direction`, label: en ? 'Direction' : 'Định hướng' },
  { href: `${home}#faq`, label: en ? 'FAQ' : 'Hỏi đáp' },
  { href: blog, label: en ? 'Guides' : 'Hướng dẫn', key: 'blog' },
];
const themes = [
  { value: 'light', label: en ? 'Light' : 'Sáng' },
  { value: 'dark', label: en ? 'Dark' : 'Tối' },
  { value: 'system', label: en ? 'System' : 'Hệ thống' },
];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(equivalents.en, Astro.site).href} />
    <link rel="alternate" hreflang="vi" href={new URL(equivalents.vi, Astro.site).href} />
    <link rel="sitemap" type="application/xml" href={sitemap} />
    <link rel="icon" type="image/svg+xml" href={publicPath('/favicon.svg')} />
    <script is:inline src={publicPath('/theme.js')}></script>
    <script is:inline src={publicPath('/navigation.js')} defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{en ? 'Skip to main content' : 'Bỏ qua tới nội dung chính'}</a>
    <header class="site-header">
      <div class="wrap">
        <a
          class="wordmark"
          href={homeLink}
          aria-label={en ? 'TiHoMo, home' : 'TiHoMo, về trang chủ'}
        >TiHoMo<span class="brand-dot" aria-hidden="true"></span></a>
        <div class="mobile-controls">
          <a
            class="mobile-control mobile-locale-control"
            href={equivalents[en ? 'vi' : 'en']}
            lang={locale}
            hreflang={en ? 'vi' : 'en'}
            data-locale-cycle={en ? 'vi' : 'en'}
            aria-label={en ? 'Language: English. Switch to Vietnamese.' : 'Ngôn ngữ: Tiếng Việt. Chuyển sang tiếng Anh.'}
            title={en ? 'Switch to Vietnamese' : 'Chuyển sang tiếng Anh'}
          >{en ? 'EN' : 'VI'}</a>
          <button
            class="mobile-control mobile-theme-control"
            type="button"
            data-theme-cycle
            data-theme-mode="system"
            data-label-system={en ? 'Theme: System. Switch to Light.' : 'Giao diện: Hệ thống. Chuyển sang Sáng.'}
            data-label-light={en ? 'Theme: Light. Switch to Dark.' : 'Giao diện: Sáng. Chuyển sang Tối.'}
            data-label-dark={en ? 'Theme: Dark. Switch to System.' : 'Giao diện: Tối. Chuyển sang Hệ thống.'}
            aria-label={en ? 'Theme: System. Switch to Light.' : 'Giao diện: Hệ thống. Chuyển sang Sáng.'}
            title={en ? 'Theme: System. Switch to Light.' : 'Giao diện: Hệ thống. Chuyển sang Sáng.'}
            hidden
          >
            <svg data-theme-icon="system" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8m-4-4v4" />
            </svg>
            <svg data-theme-icon="light" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
            </svg>
            <svg data-theme-icon="dark" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z" />
            </svg>
          </button>
        </div>
        <nav class="site-nav" aria-label={en ? 'Main navigation' : 'Điều hướng chính'}>
          <ul>
            {nav.map(item => (
              <li class:list={{ 'nav-page': item.key === 'blog' }}>
                <a
                  href={item.href}
                  aria-current={
                    item.key && item.key === current
                      ? (Astro.url.pathname === item.href ? 'page' : 'true')
                      : undefined
                  }
                >{item.label}{item.key === 'blog' && <span class="page-link-arrow" aria-hidden="true">→</span>}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="controls">
          <nav class="segmented language-control" aria-label={en ? 'Language' : 'Ngôn ngữ'}>
            <a
              href={equivalents.vi}
              lang="vi"
              hreflang="vi"
              data-locale-choice="vi"
              aria-current={!en ? 'page' : undefined}
            >VI</a>
            <a
              href={equivalents.en}
              lang="en"
              hreflang="en"
              data-locale-choice="en"
              aria-current={en ? 'page' : undefined}
            >EN</a>
          </nav>
          <div
            class="segmented theme-control"
            role="group"
            aria-label={en ? 'Color theme' : 'Giao diện'}
            hidden
          >
            {themes.map(theme => (
              <button
                type="button"
                data-theme-choice={theme.value}
                aria-pressed={theme.value === 'system' ? 'true' : 'false'}
              >{theme.label}</button>
            ))}
          </div>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-layout">
        <div>
          <a class="wordmark" href={homeLink}>TiHoMo<span class="brand-dot" aria-hidden="true"></span></a>
          <p>{en ? 'Reduce manual bookkeeping. Stay in control of your finances.' : 'Giảm ghi chép thủ công. Chủ động kiểm soát tài chính.'}</p>
        </div>
        <div>
          <nav aria-label={en ? 'Footer links' : 'Liên kết cuối trang'}>
            <ul>
              <li><a href={homeLink}>{en ? 'Home' : 'Trang chủ'}</a></li>
              <li><a href={`${home}#direction`}>{en ? 'Feature direction' : 'Định hướng tính năng'}</a></li>
              <li><a href={`${home}#faq`}>{en ? 'FAQ' : 'Hỏi đáp'}</a></li>
              <li><a href={blog}>{en ? 'Financial management guides' : 'Hướng dẫn quản lý tài chính'}</a></li>
            </ul>
          </nav>
          <p>{
            en
              ? 'TiHoMo is in development and is not publicly available. This content is for general information and does not constitute financial, tax or legal advice.'
              : 'TiHoMo đang được phát triển và chưa phát hành công khai. Nội dung chỉ cung cấp thông tin chung, không phải tư vấn tài chính, thuế hoặc pháp lý.'
          }</p>
          <p>{
            en
              ? 'This site does not require registration or collect information through forms. It does not use analytics, advertising or tracking cookies.'
              : 'Trang này không yêu cầu đăng ký hoặc thu thập thông tin qua biểu mẫu; không sử dụng công cụ phân tích truy cập, quảng cáo hoặc cookie theo dõi.'
          }</p>
        </div>
      </div>
    </footer>
  </body>
</html>
